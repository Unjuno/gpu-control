FROM python:3.12-slim
ENV GRADIO_ANALYTICS_ENABLED=False \
    HF_HUB_DISABLE_TELEMETRY=1
WORKDIR /app/gateway
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY gateway/requirements.txt gateway/requirements-worker.txt ./
COPY pyproject.toml README.md /app/
COPY src/ /app/src/
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY gateway/gpu_gateway ./gpu_gateway
COPY sites/gpu-control-sites/modal/provider_runtime ./provider_runtime
COPY gateway/workloads ./workloads
RUN useradd --uid 10001 --create-home worker
USER worker
CMD ["python", "-m", "gpu_gateway.worker", "--poll-seconds", "3"]
