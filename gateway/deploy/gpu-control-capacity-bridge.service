[Unit]
Description=Ingest GPU Control capacity events into the private outbox
After=gpu-control-artifact-capacity.service

[Service]
Type=oneshot
User=gpu-control-capacity-bridge
Group=gpu-control-capacity-bridge
WorkingDirectory=/opt/gpu-control/gateway
SupplementaryGroups=gpu-control-capacity-events
ExecStart=/opt/gpu-control/venv/bin/python /opt/gpu-control/gateway/deploy/capacity_event_bridge.py --poll-once --events-path /var/lib/gpu-control-capacity-events/events.json --state-path /var/lib/gpu-control-capacity-bridge/state.json
StateDirectory=gpu-control-capacity-bridge
StateDirectoryMode=0700
ReadOnlyPaths=/var/lib/gpu-control-capacity-events
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
