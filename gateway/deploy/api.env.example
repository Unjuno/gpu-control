# API-only authentication settings. Never load this file into worker,
# supervisor, migration, or capacity-monitor services.
# Install as /etc/gpu-control/api.env, owned by root:root, mode 0600.

# Only required for external OIDC browser login. Generate a Fernet key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Built-in local OAuth stores opaque sessions in PostgreSQL and does not use this.
# GATEWAY_COOKIE_KEY=REPLACE_WITH_OUTPUT_OF_FERNET_GENERATE_KEY

# Optional external OIDC mode. Configure all values together; leave them
# unset for built-in local OAuth.
# GATEWAY_OIDC_ISSUER=https://issuer.example.com
# GATEWAY_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# GATEWAY_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example.com/authorize
# GATEWAY_OIDC_TOKEN_ENDPOINT=https://issuer.example.com/token
# GATEWAY_OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# GATEWAY_OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# GATEWAY_ALLOWED_SUBJECTS=REPLACE_WITH_SUBJECT
