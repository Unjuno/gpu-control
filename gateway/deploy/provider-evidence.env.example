# Optional read-only RunPod catalog evidence collection for the normal worker.
# Install as /etc/gpu-control/provider-evidence.env, root:root mode 0600.
# This file is loaded by gpu-control-worker.service only, never by the API or
# recovery supervisor. Keep GATEWAY_ENABLE_RUNPOD_BRIDGE=false in gateway.env.
# Collection also requires the matching public key in gateway.env.
# GATEWAY_ENABLE_RUNPOD_EVIDENCE=false
# RUNPOD_API_KEY=REDACTED
# Generate a dedicated Ed25519 key; encode the private PEM as one-line base64.
# GATEWAY_PROVIDER_EVIDENCE_SIGNING_KEY_ID=worker-2026-01
# GATEWAY_PROVIDER_EVIDENCE_SIGNING_KEY_B64=BASE64_OF_PRIVATE_PEM
