# Common non-secret settings for API, worker, supervisor and migration.
# Install as /etc/gpu-control/gateway.env, owned by root:root, mode 0600.
# Database credentials are service-specific: api-db.env, worker-db.env, and
# migrate-db.env. Never put a shared credential in this file.
GATEWAY_HOSTED=true
GATEWAY_PUBLIC_URL=https://mcp.example.com
GATEWAY_WORKLOADS_FILE=/etc/gpu-control/workloads.json
GATEWAY_CLIENT_IP_MODE=trusted_proxy
# The API unit binds to loopback. Include only the immediate TLS proxy address
# ranges, and configure that proxy to overwrite X-Forwarded-For with its peer.
GATEWAY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
GATEWAY_LOCAL_CPU_POLICY_FILE=/etc/gpu-control/local-cpu.json
GATEWAY_ARTIFACT_DIR=/var/lib/gpu-control/artifacts
GATEWAY_ARTIFACT_MIN_FREE_BYTES=1073741824
GATEWAY_ENABLE_MODAL=false
GATEWAY_ENABLE_RUNPOD_BRIDGE=false
# Free-provider acceptance lanes remain disabled until the operator has
# configured the matching worker-only credentials, exact allowlists, current
# included-quota evidence, and a fresh one-use owner authorization. Enabling a
# lane here configures it; it does not authorize a provider call.
GATEWAY_ENABLE_KAGGLE=false
GATEWAY_ENABLE_HUGGINGFACE_SPACE=false
# Canonical non-secret provider identities and trusted local worker paths.
# Replace the examples only after the owner account and private resources have
# been verified. The systemd worker StateDirectory owns /var/lib/gpu-control.
GATEWAY_KAGGLE_USERNAME=replace-with-kaggle-owner
GATEWAY_KAGGLE_STAGING_ROOT=/var/lib/gpu-control/kaggle-stage
# The operator-owned exact-commit checkout is read-only to the worker and kept
# outside its writable StateDirectory.
GATEWAY_KAGGLE_SOURCE_CACHE_ROOT=/opt/gpu-control/source-cache/orbitune
GATEWAY_HF_ARTIFACT_REPOSITORIES=replace-owner/private-orbitune-artifacts
GATEWAY_HF_SPACE_ALLOWLIST=replace-owner/private-orbitune-zero-gpu
GATEWAY_MAX_INFLIGHT=1
# Public signing-key set for worker-collected provider observations. Public
# keys are safe to distribute; keep this empty until evidence collection is
# deliberately configured. Values are PEM strings inside one-line JSON.
GATEWAY_PROVIDER_EVIDENCE_PUBLIC_KEYS_JSON={}
# Namespaced public keys for candidate receipts: provider:<provider>:<key-id>
# or adapter:<provider>:<key-id>. Do not reuse the provider-evidence key.
GATEWAY_CANDIDATE_RECEIPT_PUBLIC_KEYS_JSON={}
