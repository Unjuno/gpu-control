# Common runtime settings for API, worker, supervisor and migration.
# Install as /etc/gpu-control/gateway.env, owned by root:root, mode 0600.
# This file contains a database credential. Keep API authentication settings
# in api.env instead.
GATEWAY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/gateway?sslmode=require
GATEWAY_HOSTED=true
GATEWAY_PUBLIC_URL=https://mcp.example.com
GATEWAY_WORKLOADS_FILE=/etc/gpu-control/workloads.json
GATEWAY_LOCAL_CPU_POLICY_FILE=/etc/gpu-control/local-cpu.json
GATEWAY_ARTIFACT_DIR=/var/lib/gpu-control/artifacts
GATEWAY_ARTIFACT_MIN_FREE_BYTES=1073741824
GATEWAY_ENABLE_MODAL=false
GATEWAY_ENABLE_RUNPOD_BRIDGE=false
GATEWAY_MAX_INFLIGHT=1
# Public signing-key set for worker-collected provider observations. Public
# keys are safe to distribute; keep this empty until evidence collection is
# deliberately configured. Values are PEM strings inside one-line JSON.
GATEWAY_PROVIDER_EVIDENCE_PUBLIC_KEYS_JSON={}
# Namespaced public keys for candidate receipts: provider:<provider>:<key-id>
# or adapter:<provider>:<key-id>. Do not reuse the provider-evidence key.
GATEWAY_CANDIDATE_RECEIPT_PUBLIC_KEYS_JSON={}
