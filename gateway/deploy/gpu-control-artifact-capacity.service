[Unit]
Description=Check GPU Control artifact filesystem capacity
RequiresMountsFor=/var/lib/gpu-control/artifacts

[Service]
Type=oneshot
User=gpu-control-capacity
Group=gpu-control-capacity-events
SupplementaryGroups=gpu-control-capacity-probe
SyslogIdentifier=gpu-control-capacity
StandardOutput=journal
StandardError=journal
StateDirectory=gpu-control-capacity-events
StateDirectoryMode=0750
WorkingDirectory=/opt/gpu-control/gateway
EnvironmentFile=/etc/gpu-control/capacity.env
ExecStart=/opt/gpu-control/venv/bin/python /opt/gpu-control/gateway/deploy/check_artifact_capacity.py
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
