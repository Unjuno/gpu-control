[Unit]
Description=Check GPU Control artifact filesystem capacity
RequiresMountsFor=/var/lib/gpu-control/artifacts

[Service]
Type=oneshot
User=gpu-control
Group=gpu-control
WorkingDirectory=/opt/gpu-control/gateway
EnvironmentFile=/etc/gpu-control/worker.env
ExecStart=/opt/gpu-control/venv/bin/python /opt/gpu-control/gateway/deploy/check_artifact_capacity.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
