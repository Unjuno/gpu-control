# Optional provider credentials for worker and recovery supervisor only.
# Copy to /etc/gpu-control/worker-secrets.env, root:root mode 0600, only when
# an explicitly reviewed provider integration needs credentials. Keep this
# file absent or empty while provider integrations are disabled.
# Never place database, OAuth, cookie, workload, or policy settings here.
# Example Modal API token variables (obtain values from the approved secret store):
# MODAL_TOKEN_ID=REDACTED
# MODAL_TOKEN_SECRET=REDACTED
# RunPod account lease identity is a stable, non-secret ID shared across every
# credential for one account. Keep it unchanged during API-key rotation.
# GATEWAY_RUNPOD_ACCOUNT_SCOPE_ID=runpod-primary
# Non-interactive Kaggle CLI token. The official CLI supports
# KAGGLE_API_TOKEN directly, so no credential file or writable home directory
# is required. Generate it from the owner's Kaggle account and revoke/rotate it
# independently of the Hugging Face credential.
# KAGGLE_API_TOKEN=REDACTED
# Hugging Face fine-grained write token scoped only to the approved private
# artifact repository. Never pass it to Space code, the public API process,
# ChatGPT/MCP, or a Kaggle workload.
# HF_ARTIFACT_WRITE_TOKEN=REDACTED
# Distinct fine-grained read token scoped to the approved private Space, plus
# Billing read permission for get_zero_gpu_quota(). It must not grant model
# repository writes and must not equal HF_ARTIFACT_WRITE_TOKEN.
# HF_SPACE_READ_TOKEN=REDACTED
# Distinct Ed25519 adapter key; never reuse the provider-observation key.
# GATEWAY_CANDIDATE_RECEIPT_SIGNING_KEY_IDS=adapter:kaggle:worker-v1,adapter:huggingface_space:worker-v1
# GATEWAY_CANDIDATE_RECEIPT_SIGNING_KEY_B64=REDACTED
