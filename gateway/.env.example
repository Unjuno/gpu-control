# Copy values into your deployment's secret manager; do not commit filled values.
# API and worker must share the same database and workload registry.
# On Vercel, a connected Neon resource may provide DATABASE_URL automatically.
# GATEWAY_DATABASE_URL overrides DATABASE_URL when explicitly set.
GATEWAY_DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is omitted.
GATEWAY_PUBLIC_URL=https://your-project.vercel.app
GATEWAY_HOSTED=true
GATEWAY_OIDC_ISSUER=https://your-issuer.example
GATEWAY_OIDC_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
GATEWAY_OIDC_AUTHORIZATION_ENDPOINT=https://your-issuer.example/authorize
GATEWAY_OIDC_TOKEN_ENDPOINT=https://your-issuer.example/token
GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=
GATEWAY_ALLOWED_SUBJECTS=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GATEWAY_COOKIE_KEY=
GATEWAY_MAX_INFLIGHT=1
GATEWAY_MAX_JOB_COST_USD=1
GATEWAY_ENABLE_MODAL=false
GATEWAY_MODAL_APP=gpu-control
GATEWAY_WORKLOADS_JSON={"demo":{"provider":"demo"}}
# Existing RunPod CI is NOT changed/dispatched by this gateway.
GATEWAY_ENABLE_RUNPOD_BRIDGE=false
GATEWAY_RUNPOD_FACTORY=
# Modal SDK credentials belong on the worker only, never the browser/API deployment.
