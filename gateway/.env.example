# API-only deployment example. Never pass this file to worker, supervisor, or
# migration processes; use their dedicated database URLs/roles instead.
# Set GATEWAY_DATABASE_URL explicitly even when the host injects DATABASE_URL,
# so the public API never falls back to a broader integration credential.
# Replace this placeholder with an absolute CA-bundle path that exists in the
# deployed API runtime and is readable there. Vercel runtime CA paths have not
# been verified; do not deploy this value unchanged.
GATEWAY_DATABASE_URL=postgresql+psycopg://gpu_control_api:REPLACE@DB_HOST:5432/gateway?sslmode=verify-full&sslrootcert=/absolute/path/to/trusted-provider-ca.pem
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is omitted.
GATEWAY_PUBLIC_URL=https://your-project.vercel.app
GATEWAY_HOSTED=true
# Generate a unique secret of at least 32 bytes per environment. This is used
# only to HMAC the login source bucket; keep it in API secrets, never in worker
# or workload configuration.
GATEWAY_CLIENT_IP_HASH_KEY=
GATEWAY_OIDC_ISSUER=https://your-issuer.example
GATEWAY_OIDC_JWKS_URL=https://your-issuer.example/.well-known/jwks.json
GATEWAY_OIDC_AUTHORIZATION_ENDPOINT=https://your-issuer.example/authorize
GATEWAY_OIDC_TOKEN_ENDPOINT=https://your-issuer.example/token
GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=
GATEWAY_ALLOWED_SUBJECTS=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GATEWAY_COOKIE_KEY=
GATEWAY_MAX_INFLIGHT=1
GATEWAY_MAX_JOB_COST_USD=1
# Optional. Set only when API and worker share a durable mounted directory.
# GATEWAY_ARTIFACT_DIR=/var/lib/gpu-control/artifacts
GATEWAY_ENABLE_MODAL=false
GATEWAY_MODAL_APP=gpu-control
GATEWAY_WORKLOADS_JSON={"demo":{"provider":"demo"}}
# Existing RunPod CI is NOT changed/dispatched by this gateway.
GATEWAY_ENABLE_RUNPOD_BRIDGE=false
GATEWAY_RUNPOD_FACTORY=
# Modal SDK credentials belong on the worker only, never the browser/API deployment.
