include LICENSE README.md SECURITY.md AGENTS.md ACTION_CONSTITUTION.md CONTRIBUTING.md
include pyproject.toml uv.lock
recursive-include src *.py *.yaml
recursive-include tests *.py
recursive-include policies *.yaml
recursive-include docs *.md
recursive-include examples *.py *.yaml *.md Dockerfile
recursive-include .github *.yml *.yaml *.md
recursive-include scripts *.py
exclude .coverage
prune audit
prune dist
prune build
prune .venv
global-exclude __pycache__ *.py[cod]
